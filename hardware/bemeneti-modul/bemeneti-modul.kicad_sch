		(uuid "70885b3b-2f0d-5ed0-b25f-c36256589077")
	)
	(text "IN0–IN3"
		(exclude_from_sim no)
		(at 147.4 77.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7424c698-2e56-5486-8810-a9af95d276e2")
	)
	(text "Alap: R_fel 10k + R_s 10k + C 10n – osztó nélkül csak ≤ 5 V-os jel mehet a bemenetre. 12/24 V-os jel: R_fel ki, R_s 68k, R_le 10k; 5 V: R_s 2k2, R_le 3k9."
		(exclude_from_sim no)
		(at 80 97.5 0)
