(version 1)
# JLCPCB, 4 réteg, 1 oz (D42, D82) – felár nélküli értékek. Generálta: Claude (D86). A nyitott KiCad nem írja felül
# (hálózatosztályok helyett név szerinti feltételek). Megnézni: Board Setup → Custom Rules. A később felsorolt szabály erősebb.
(rule "JLC: sáv és rés"
  (constraint track_width (min 0.127mm))
  (constraint clearance (min 0.127mm)))
# via: a JLC felár nélküli legkisebbje 0,3 mm-es fúrt furat / 0,45 mm-es pad (kisebb = felár); ~1 A / via
(rule "Via: jel (JLC, felár nélkül)"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.3mm) (opt 0.3mm))
  (constraint via_diameter (min 0.45mm) (opt 0.45mm))
  (constraint annular_width (min 0.075mm)))
(rule "JLC: furat"
  (constraint hole_clearance (min 0.25mm))
  (constraint hole_to_hole (min 0.25mm)))
(rule "JLC: lapszél"
  (constraint edge_clearance (min 0.3mm)))
(rule "JLC: szitanyomat"
  (layer "?.Silkscreen")
  (constraint text_height (min 0.8mm))
  (constraint text_thickness (min 0.15mm)))
(rule "Táp: sáv 0.6mm"
  (condition "A.NetName == '+5V' || A.NetName == '/GND_BUS' || A.NetName == '+12V'")
  (constraint track_width (min 0.3mm) (opt 0.6mm)))
(rule "Táp: via 0.4mm / 0.7mm (1 A felett több via)"
  (condition "A.Type == 'Via' && (A.NetName == '+5V' || A.NetName == '/GND_BUS' || A.NetName == '+12V')")
  (constraint hole_size (min 0.3mm) (opt 0.4mm))
  (constraint via_diameter (min 0.45mm) (opt 0.7mm)))
(rule "Táp: sáv 0.4mm"
  (condition "A.NetName == '+3V3' || A.NetName == '/modulmag/+3V3A'")
  (constraint track_width (min 0.3mm) (opt 0.4mm)))
(rule "Táp: via 0.4mm / 0.7mm (1 A felett több via)"
  (condition "A.Type == 'Via' && (A.NetName == '+3V3' || A.NetName == '/modulmag/+3V3A')")
  (constraint hole_size (min 0.3mm) (opt 0.4mm))
  (constraint via_diameter (min 0.45mm) (opt 0.7mm)))
# D82: a nagyáramú út 1 oz-on fedetlen réz, ónnal / dróttal megvastagítva; inkább kitöltés (zóna), mint sáv. 15 A (D84).
# Rétegváltásnál viamező: 0,6 / 1,0 mm-es viák, ~2,5 A / via → 15 A-hez ≥ 8 db (jobb: az út egy rétegen marad).
(rule "Nagyáram (15 A): sáv"
  (condition "A.NetName == '/+24V_IN' || A.NetName == '/+24V_RAIL' || A.NetName == '/+24V_B?' || A.NetName == '/CH?_D' || A.NetName == '/PGND_SH' || A.NetName == '/GND_IN'")
  (constraint track_width (min 1.0mm) (opt 3.0mm))
  (constraint clearance (min 0.3mm)))
(rule "Nagyáram (15 A): via 0,6 / 1,0 mm"
  (condition "A.Type == 'Via' && (A.NetName == '/+24V_IN' || A.NetName == '/+24V_RAIL' || A.NetName == '/+24V_B?' || A.NetName == '/CH?_D' || A.NetName == '/PGND_SH' || A.NetName == '/GND_IN')")
  (constraint hole_size (min 0.3mm) (opt 0.6mm))
  (constraint via_diameter (min 0.45mm) (opt 1.0mm)))
